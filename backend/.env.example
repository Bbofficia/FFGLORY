FFGLORY_BASE=https://ffglory.pro
FFGLORY_API_KEY=your_ffglory_api_key
FFGLORY_MASTER_KEY=your_ffglory_master_key
APP_ACCESS_TOKEN=optional_service_token
PORT=8080
DATA_DIR=./data

# Optional first admin account (password should be 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Security / deployment
NODE_ENV=development
CORS_ORIGINS=
TRUST_PROXY=false

# In production, use a real database/session store and HTTPS reverse proxy.
